# Gemini API キー（Google AI Studio から取得）
GEMINI_API_KEY=your_gemini_api_key_here

# Google サービスアカウントの認証情報（JSON文字列）
# Google Cloud Console → IAM → サービスアカウント → キー作成 で取得
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google Drive のフォルダID（ドキュメントの保存先）
# フォルダのURL: https://drive.google.com/drive/folders/XXXXX ← この XXXXX 部分
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Flask設定
FLASK_ENV=production
SECRET_KEY=your_secret_key_here

# フロントエンドのURL（CORS設定用）
FRONTEND_URL=https://your-app.onrender.com
